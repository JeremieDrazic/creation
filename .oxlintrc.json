{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "jsPlugins": [
    {
      "name": "stylex",
      "specifier": "@stylexjs/eslint-plugin"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/consistent-type-imports": "error",
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error",
    "react/button-has-type": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "stylex/valid-styles": "error",
    "stylex/valid-shorthands": "error",
    "stylex/no-unused": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@creation/[^/]+/src/",
            "message": "Use a declared package export, not another package\u2019s implementation path."
          },
          {
            "regex": "^(\\.\\./)+(packages|apps)/",
            "message": "Cross workspace boundaries through declared package exports."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/dist/**",
    "**/storybook-static/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ]
}
