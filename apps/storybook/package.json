  },
  "devDependencies": {
    "storybook": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "@creation/config": "workspace:*"
  }
