{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "**/routeTree.gen.ts",
    "**/dist/**",
    "**/storybook-static/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "moodboard/branding/typeface-study/fonts/*"
  ]
}
